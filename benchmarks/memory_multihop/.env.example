# Copy to benchmarks/memory_multihop/.env and fill in. This file is git-ignored.
# The harness prefers Azure; if Azure vars are absent it falls back to OPENAI_API_KEY.

# --- LLM (OpenIE extraction + QA reader), Azure OpenAI Responses ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.5

# --- Embeddings (vector baseline + PPR entity vectors) ---
# Model choice is SM-R4's ratified decision (benchmarks/memory_embedding/DECISION.md §1):
#   Mode A (default, credential-free): BAAI/bge-base-en-v1.5 @ 768, sentence-transformers
#   Mode B (provider allowed):         Azure text-embedding-3-large @ 1024
# Leave HARNESS_EMBED_BACKEND unset to get Mode A unless Azure embed creds are present.
# HARNESS_EMBED_BACKEND=local        # local | azure | openai

# Mode B only — fill these to run against Azure:
AZURE_EMBEDDER_OPENAI_API_KEY=
AZURE_EMBEDDER_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_EMBEDDER_OPENAI_API_VERSION=2024-10-21
AZURE_EMBEDDER_DEPLOYMENT=text-embedding-3-large

# --- Plain OpenAI fallback (used only if the Azure vars above are unset) ---
# OPENAI_API_KEY=
# HARNESS_OPENAI_MODEL=gpt-5.5
# HARNESS_EMBED_MODEL=text-embedding-3-large

# --- Harness knobs ---
# HARNESS_LLM_MODE=auto        # auto | replay | live
# HARNESS_EMBED_MODE=auto      # auto | replay
# HARNESS_MODEL_TAG=gpt-5.4    # stable cache tag for the reader/extractor
# HARNESS_EMBED_TAG=...        # leave unset: defaults to "<backend>:<model>@<dim>" so a
#                              # model change invalidates the embed cache automatically.
#                              # Pinning it to a constant would silently replay the old
#                              # model's vectors against a new model.
# HARNESS_PRICE_IN=1.25        # USD / 1M input tokens (for cost accounting)
# HARNESS_PRICE_OUT=10.0       # USD / 1M output tokens
