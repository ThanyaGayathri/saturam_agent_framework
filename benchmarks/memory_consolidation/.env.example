# Copy to `.env` (gitignored) and fill in. The harness loads this file automatically.
#
# Azure OpenAI (Responses API) — the LLM backend for the consolidation harness.
# Endpoint + API version come from your Azure resource; deployment is the *name*
# you gave the gpt-5.4 model when you deployed it in the Azure portal (NOT the raw
# model id). Example screenshot value: a deployment named "gpt-5.4" serving gpt-5.4.

AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_ENDPOINT=https://aicoekey.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=your-gpt-5.4-deployment-name

# Optional: separate (smaller/cheaper) deployment used only by the extractor step,
# to emulate an on-prem SLM extractor. Falls back to AZURE_OPENAI_DEPLOYMENT if unset.
# AZURE_OPENAI_EXTRACTOR_DEPLOYMENT=your-slm-deployment-name
