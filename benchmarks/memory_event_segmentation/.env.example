# Copy this file to `.env` (which is gitignored) and fill in real values.
# The harness loads `.env` automatically for the LLM segmentation option only;
# the offline candidates (single_session, per_turn, fixed_window, time_gap,
# embedding_drift, surprise_em_llm) need none of this.

# --- Azure OpenAI (Responses API) ---------------------------------------
# The subscription key from the Azure portal. Keep it here, never in git.
AZURE_OPENAI_API_KEY=

# Resource endpoint (no trailing path).
AZURE_OPENAI_ENDPOINT=https://aicoekey.cognitiveservices.azure.com/

# Responses API version (your snippet used this one).
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# The *deployment name* of the model to segment with (this is what Azure calls
# the deployment, not the base model id). e.g. a gpt-5.4 / gpt-5.5 deployment.
AZURE_OPENAI_DEPLOYMENT=

# --- Local on-prem SLM alternative (ollama) -----------------------------
# Optional. Only used for `--llm-provider ollama`. No key needed.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
