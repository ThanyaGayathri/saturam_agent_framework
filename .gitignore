# See https://help.github.com/ignore-files/ for more about ignoring files.

.DS_Store

# Python cache
.mypy_cache
*__pycache__*
*.egg-info
*.pyc
*.pytest_cache
*.ruff_cache
.import_linter_cache
*.cache*

# Machine specific
.idea
.vscode
*.code-workspace

# Ignore .env files
.env
azure_llm.env
# Any *.env secret file (azure_key.env, azure_llm.env, ...). Listing them by name
# missed azure_key.env, which left a live API key one `git add -A` from being
# committed. No tracked file ends in `.env` — `.env.example` is unaffected.
*.env
azure_key.txt

# Ignore .envrc files (used by direnv: https://direnv.net/)
.envrc

certs/

# ignore storage dir
/storage
.images
/qdrant_storage

# ignore wip dir
wip

# ignore dist dir
dist

# Frontend and deployment scratch. `deploy/**/*.config*` is scoped to deploy/ only: it used
# to be a repo-wide `*.config*` pattern, which silently untracked frontend/vite.config.js,
# tailwind.config.js and postcss.config.js too -- nobody could run the frontend from a fresh
# clone until that was noticed and fixed.
node_modules/
frontend/dist/
frontend/.vite/
deploy/local/
deploy/**/*.config*
kubeconfig*

# ignore virtualenvs
.venv*
.perfenv*
.demoenv*
.gemini-agents*
.getting-started*
venv*
aienv*
phienv*
set-env.ps1

# ignore tmp dirs
scratch
junk
tmp
agents.db
data.db
.ipynb_checkpoints
build
audio_generations

*.db

# Google OAuth tokens
gmail_token.json
calendar_token.json
gdrive_token.json

.composio.lock

# Coverage
coverage_report
.coverage

# JSON files used as testing DB
agno_json_data/

# Wiki cookbook artifacts
cookbook/12_context/demo-wiki/
cookbook/12_context/demo-wiki-web/
cookbook/12_context/demo-wiki-dual/
cookbook/12_context/demo-wiki-git/

# AI. `.claude/settings.json` is the one tracked file: team-wide Claude Code settings
# (attribution off). Everything else under .claude/ (settings.local.json, worktrees,
# scratch) stays personal.
.claude/*
!.claude/settings.json
.cursor/
.conductor/
.context/
.codex/

# Private design documents (symlinked). Keep docs/adr/ and the contributor guides
# tracked for in-repo documentation.
/specs
/docs/*
!/docs/adr/
!/docs/adr/**
!/docs/capability-policy.md
!/docs/component-config-schema.md
!/docs/component-lifecycle.md
!/docs/component-portability.md
!/docs/di.md
!/docs/integrations-inventory.md
!/docs/tenancy.md
!/docs/MEMORY-RESEARCH-episodic-and-neurosymbolic.md
!/docs/plan/
!/docs/plan/**
/projects
/agno-os
/apps

# Private Claude coding session preferences
CLAUDE_PRIVATE.md

# ignore pyrightconfig.json
pyrightconfig.json
.python-version
CLAUDE_PRIVATE.md
