# Copy to `.env` in this folder for local dev. Do not commit real secrets.
#
# --- Retail API (product/egpt_retail) ---
# Base URL for the real backend. Defaults to http://localhost:7777, the port
# deploy/compose.yaml exposes (EGPT_RETAIL_API_PORT). The API's default CORS allow-list only
# covers http://localhost:3000 (see vite.config.js's server.port) - a different dev port needs
# CORS_ORIGIN_LIST set on the API. See deploy/README.md.
# VITE_API_URL=http://localhost:7777
#
# --- LLM (server-side only; not bundled in the browser) ---
# Set these in Vercel → Environment Variables for Production/Preview (no VITE_ prefix).
# Local `npm run dev` loads them via the dev API plugin for /api/llm/*.
#
# RETAILGPT_LLM_PROVIDER=openai
# Azure example: RETAILGPT_LLM_PROVIDER=azure
# RETAILGPT_LLM_API_BASE_URL=
# RETAILGPT_LLM_API_KEY=
# RETAILGPT_LLM_MODEL=gpt-4o-mini
# RETAILGPT_LLM_AZURE_DEPLOYMENT=my-gpt-deployment
# RETAILGPT_LLM_AZURE_API_VERSION=2024-06-01
# If RETAILGPT_LLM_AZURE_DEPLOYMENT is omitted, RETAILGPT_LLM_MODEL is used as the deployment name.
#
# gpt-5, gpt-4.1 (new schema), and o-series models require `max_completion_tokens`
# instead of `max_tokens`. The server auto-detects based on RETAILGPT_LLM_MODEL /
# RETAILGPT_LLM_AZURE_DEPLOYMENT name. To force the field name, set:
# RETAILGPT_LLM_TOKENS_PARAM=max_completion_tokens
# RETAILGPT_LLM_TOKENS_PARAM=max_tokens
#
# Optional: verbose client logs (metadata only; no API key or prompts in logs)
# VITE_LLM_DEBUG=true
#
# --- TTS for the guided tour (Azure OpenAI, optional) ---
# Set to the name of a tts / tts-hd deployment on the same Azure resource.
# Create via oai.azure.com Studio -> Deployments -> Deploy tts-1 or tts-1-hd.
# RETAILGPT_LLM_TTS_DEPLOYMENT=tts
# RETAILGPT_LLM_TTS_API_VERSION=2024-05-01-preview
#
# --- Prototype login (server-side; see CLAUDE.md) ---
# PROTOTYPE_LOGIN_USER=demo
# PROTOTYPE_LOGIN_PASSWORD=
# PROTOTYPE_AUTH_SECRET=
