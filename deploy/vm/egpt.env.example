# API + consolidator environment for the single-VM stack. Copy to ~/egpt/egpt.env on the VM
# (outside the checkout: deploy.sh runs `git reset --hard`). Every value the compose file
# fixes (DB URLs, Neo4j URI, ports, overlay path) is set there and must not be repeated here.

# Azure OpenAI (chat). The framework's own variable names, see deploy/README.md.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
EGPT_RETAIL_AZURE_DEPLOYMENT=gpt-5.4
EGPT_RETAIL_AZURE_SMALL_DEPLOYMENT=gpt-5.4-mini

# Azure OpenAI (embedder) -- needed the moment a memory or knowledge row is written.
# Commented out (unset) to run the way the local demo does: an empty value is not unset.
# AZURE_EMBEDDER_OPENAI_API_KEY=
# AZURE_EMBEDDER_OPENAI_ENDPOINT=
# AZURE_EMBEDDER_DEPLOYMENT=

# Tenant. The consolidator exits without one.
EGPT_RETAIL_CUSTOMER_SLUG=northwind

# Neo4j password; compose passes the same value to the neo4j container.
EGPT_RETAIL_NEO4J_PASSWORD=password

# The browser origin the frontend is served from. JSON array, not a comma list.
EGPT_CORS_ORIGIN_LIST=["https://enterprisegpt.saturam.com"]

# Report mailbox (product/egpt_retail/documents/mailbox.py): the source mailbox reports and
# alerts go out through, and the fallback for any field a mailbox source record leaves out.
# Without these a run fails at "Send report" with "env:gmail: GMAIL_USER, GMAIL_APP_PASSWORD
# not set in the environment".
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_IMAP_HOST=imap.gmail.com
