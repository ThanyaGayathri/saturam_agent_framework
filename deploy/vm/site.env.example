# Per-VM site settings, read by setup.sh and deploy.sh. Copy to ~/egpt/site.env on the VM.
# Absent, the scripts assume the original demo VM: enterprisegpt.saturam.com behind its
# Certbot certificate.

# Hostname (or public IP, while there is no domain) the site answers on.
SITE=20.169.82.164

# 1 = plain HTTP on port 80 with the nginx.http.site template, for a VM that has no
# certificate yet. Unset once the domain exists and Certbot has issued one; deploy.sh then
# installs nginx.site (TLS) for $SITE.
HTTP_ONLY=1
