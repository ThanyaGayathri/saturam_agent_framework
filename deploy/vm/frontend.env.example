# Frontend environment for the single-VM stack. Copy to ~/egpt/frontend.env on the VM.
# deploy.sh reads it for `npm run build` (the VITE_* values are baked into dist/) and the
# egpt-frontend systemd unit loads it for server.mjs (the /api/llm and /api/auth routes).

# Where the browser reaches the retail API. nginx proxies /backend/ to the api container.
VITE_API_URL=https://enterprisegpt.saturam.com/backend

# Server-side LLM for /api/llm/* (prototype screens still on the old chat path).
RETAILGPT_LLM_PROVIDER=azure
RETAILGPT_LLM_API_BASE_URL=https://<resource>.cognitiveservices.azure.com
RETAILGPT_LLM_API_KEY=
RETAILGPT_LLM_AZURE_DEPLOYMENT=gpt-4o
RETAILGPT_LLM_MODEL=gpt-4o
RETAILGPT_LLM_AZURE_API_VERSION=2025-01-01-preview

# Prototype login gate (server-side).
PROTOTYPE_LOGIN_USER=demo
PROTOTYPE_LOGIN_PASSWORD=
PROTOTYPE_AUTH_SECRET=
