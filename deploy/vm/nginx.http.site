# nginx site for a VM without a certificate yet (HTTP_ONLY=1 in ~/egpt/site.env): the same
# two locations as nginx.site, on port 80, answering for whatever host the request carries so
# a bare public IP works. deploy.sh installs it as /etc/nginx/sites-available/<site>.egpt and
# removes the distribution's default site so this one is the catch-all.
#
#   /backend/  -> the retail API (compose api service, 127.0.0.1:7777), prefix stripped.
#                 Buffering is off so agent runs stream (SSE) instead of arriving at the end.
#   /          -> the frontend (systemd egpt-frontend, 127.0.0.1:8081): dist/ and /api/*.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 50m;

    location /backend/ {
        proxy_pass http://127.0.0.1:7777/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /backend;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
    }
}
