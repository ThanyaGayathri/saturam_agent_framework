# nginx site for the single-VM stack, TLS. __SITE__ is replaced with $SITE (~/egpt/site.env,
# default enterprisegpt.saturam.com) when setup.sh or deploy.sh installs this as
# /etc/nginx/sites-available/<site>.egpt, so a second VM with its own hostname uses the same
# file. The certificate for $SITE must already exist: `certbot --nginx -d <site>`.
#
#   /backend/  -> the retail API (compose api service, 127.0.0.1:7777), prefix stripped.
#                 Buffering is off so agent runs stream (SSE) instead of arriving at the end.
#   /          -> the frontend (systemd egpt-frontend, 127.0.0.1:8081): dist/ and /api/*.

server {
    server_name __SITE__;

    client_max_body_size 50m;

    location /backend/ {
        proxy_pass http://127.0.0.1:7777/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /backend;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 600s;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/__SITE__/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/__SITE__/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = __SITE__) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name __SITE__;
    return 404; # managed by Certbot
}
